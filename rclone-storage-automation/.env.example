# Copy to .env and change the values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.
# MinIO requires a user of at least 3 characters and a password of at least 8.

MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Second MinIO user with read-only access (created in section 4, see commands.md)
READER_ACCESS_KEY=reader
READER_SECRET_KEY=change-me-reader-secret
